# ==========================================
# GEREKLİ ORTAM DEĞİŞKENLERİ (ENV)
# ==========================================

# 1. Google Gemini API Anahtarı (Yapay Zeka Analizi İçin)
# https://aistudio.google.com adresinden ücretsiz alabilirsiniz.
GEMINI_API_KEY=your_gemini_api_key_here

# 2. E-posta Gönderim Ayarları (Gmail SMTP vb.)
# Gmail için: Google Hesabı -> Güvenlik -> 2 Adımlı Doğrulama -> Uygulama Şifreleri (App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password_here
SENDER_EMAIL=your_email@gmail.com
RECIPIENT_EMAIL=your_email@gmail.com

# 3. Google Sheets Ayarları (Opsiyonel)
GOOGLE_SHEETS_ENABLED=false
GOOGLE_SHEETS_SPREADSHEET_NAME=İş İlanları Takip Tablosu
GOOGLE_APPLICATION_CREDENTIALS=credentials.json
